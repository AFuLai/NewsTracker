# Normalise line endings — the repo is edited from both WSL and Windows.
* text=auto eol=lf

# Files excluded from `git archive` output (zip 打包時不含)
tests/        export-ignore
.gitignore    export-ignore
.gitattributes export-ignore
db/           export-ignore
*.sqlite      export-ignore
ops/          export-ignore

# Windows launcher/installer must keep CRLF (cmd.exe parses LF-only .cmd unreliably).
*.cmd text eol=crlf
*.ps1 text eol=crlf
