# Normalise line endings — the repo is edited from both WSL and Windows.
* text=auto eol=lf

# Files excluded from `git archive` output (zip 打包時不含)
tests/        export-ignore
.gitignore    export-ignore
.gitattributes export-ignore
db/           export-ignore
*.sqlite      export-ignore
# The generated site is tracked in git, but release zips ship the engine only.
html/         export-ignore
ops/          export-ignore
