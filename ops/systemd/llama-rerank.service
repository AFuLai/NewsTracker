[Unit]
# bge-reranker-v2-m3 for the WP5 EU CRA gate. Flags mirror ops/llama-server/llama_up.sh.
Description=llama-server bge-reranker-v2-m3 (tracker WP5), CPU only
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=afu
Group=afu
Environment=LD_LIBRARY_PATH=/opt/llama.cpp/llama-b10423
ExecStart=/opt/llama.cpp/llama-b10423/llama-server \
  --model /opt/llama.cpp/models/bge-reranker-v2-m3-FP16.gguf \
  --reranking --pooling rank \
  -ngl 0 --threads 6 --ctx-size 8192 --batch-size 8192 \
  --host 127.0.0.1 --port 8082
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
