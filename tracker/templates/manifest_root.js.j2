// manifest.js — 頂層索引
const TRACKER_MANIFEST = {
  title: {{ title | tojson }},
  categories: {{ categories | tojson }},
  years: {{ years | tojson }},
  yearFiles: {
{%- for y in years %}
    {{ y | tojson }}: {{ ("data/manifest-" ~ y ~ ".js") | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
  },
  lastUpdated: {{ last_updated | tojson }}
};
