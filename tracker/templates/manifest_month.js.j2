// manifest-{{ month | replace('-', '') }}.js — {{ month }} ({{ tracker }})
window.TRACKER_MONTH = window.TRACKER_MONTH || {};
window.TRACKER_MONTH[{{ tracker | tojson }}] = window.TRACKER_MONTH[{{ tracker | tojson }}] || {};
window.TRACKER_MONTH[{{ tracker | tojson }}][{{ month | tojson }}] = {
  dates: [
{%- for d in dates %}
    { date: {{ d.date | tojson }}, file: {{ d.file | tojson }}, count: {{ d.count }} }{% if not loop.last %},{% endif %}
{%- endfor %}
  ],
  totalArticles: {{ total }},
  lastUpdated: {{ last_updated | tojson }}
};
