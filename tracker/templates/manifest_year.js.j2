// manifest-{{ year }}.js — {{ year }} ({{ tracker }})
window.TRACKER_YEAR = window.TRACKER_YEAR || {};
window.TRACKER_YEAR[{{ tracker | tojson }}] = window.TRACKER_YEAR[{{ tracker | tojson }}] || {};
window.TRACKER_YEAR[{{ tracker | tojson }}][{{ year | tojson }}] = {
  months: {{ months | tojson }},
  monthFiles: {
{%- for m in months %}
    {{ m | tojson }}: {{ ("manifest-" ~ m | replace('-', '') ~ ".js") | tojson }}{% if not loop.last %},{% endif %}
{%- endfor %}
  },
  lastUpdated: {{ last_updated | tojson }}
};
